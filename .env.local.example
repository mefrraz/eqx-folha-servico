# Supabase — obtém estas keys em https://supabase.com/dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL pública da app — usada em links de emails e convites
NEXT_PUBLIC_APP_URL=https://folhas.eqx.pt

# Service role key — para admin updateUser (email/password)
# NUNCA expor no cliente! Só server-side. Em Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin delete password — palavra-passe para confirmar eliminação de users
# Guarda esta password só para os admins da plataforma
ADMIN_DELETE_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD

# Gmail — para enviar emails de notificação
# Criar "App Password" em https://myaccount.google.com/apppasswords
GMAIL_USER=colaboradoreshoraseqx@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Remetente exibido nos emails (De:). Para usar rh@eqx.pt, adiciona esse
# endereço em Gmail > Definições > Contas > "Enviar como" e verifica-o.
EMAIL_FROM=rh@eqx.pt

# Email do admin que recebe notificações
ADMIN_EMAIL=colaboradoreshoraseqx@gmail.com

# Cron secret — para proteger o endpoint /api/cron/notify-emails
# Gerar com: openssl rand -hex 32
CRON_SECRET=

# Código de convite — necessário para o registo próprio de trabalhadores.
# Se não for definido, o registo público fica desativado (só convite do admin).
INVITE_CODE=EQX2025

# ── MARCA (white-label) ──
# O repositório tem valores neutros por defeito. Para aplicar a marca EQX,
# define estas variáveis no Vercel (Settings → Environment Variables):
NEXT_PUBLIC_APP_NAME=EQX Folha de Serviço
NEXT_PUBLIC_APP_SHORT_NAME=EQX
# Logo: aponta para o ficheiro em /public (ex: /eqx-logo.png) ou um URL remoto.
# Para usar o logo EQX original, coloca o ficheiro em public/ e aponta aqui.
NEXT_PUBLIC_LOGO_URL=/eqx-logo.png
NEXT_PUBLIC_BRAND_PRIMARY=#F1C411
NEXT_PUBLIC_BRAND_DARK=#1a1a1a
NEXT_PUBLIC_BRAND_SOFT=#54595F
NEXT_PUBLIC_BRAND_MUTED=#7A7A7A
NEXT_PUBLIC_BRAND_LIGHT=#CFCFCF
NEXT_PUBLIC_BRAND_PAGE=#F7F7F7
NEXT_PUBLIC_BRAND_SUCCESS=#61CE70
NEXT_PUBLIC_BRAND_OLIVE=#98C03E
