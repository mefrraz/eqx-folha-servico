# EQX VPS — Variáveis de ambiente
# Copiar para .env e preencher

# Connection string do Supabase para pg_dump
# Obter em: Supabase Dashboard → Settings → Database → Connection string → URI
# Formato: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:SEU_PASSWORD_AQUI@db.xxxxxxxxxxxx.supabase.co:5432/postgres
